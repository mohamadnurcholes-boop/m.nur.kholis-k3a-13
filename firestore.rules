rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products catalog: publicly readable for store visitors, manageable by authenticated admin or store operators
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Orders: customers can create orders, check order status, upload proof; admins can manage and approve
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Customers directory: record customer purchase statistics
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Store settings / stats
    match /store_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
